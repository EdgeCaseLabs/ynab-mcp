{
  "mcpServers": {
    "ynab": {
      "command": "/absolute/path/to/uv",
      "args": [
        "run",
        "--directory",
        "/absolute/path/to/ynab-mcp",
        "python",
        "-m",
        "ynab_mcp_server"
      ],
      "env": {
        "YNAB_API_KEY": "your_ynab_api_key_here",
        "DEFAULT_BUDGET_ID": ""
      }
    }
  }
}
